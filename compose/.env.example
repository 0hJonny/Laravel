BASE_DOMAIN=jim.dev

# ============================================
# Субдомены
# ============================================
APP_SUBDOMAIN=app
API_SUBDOMAIN=api
MEDIA_SUBDOMAIN=media
MINIO_CONSOLE_SUBDOMAIN=console

# ============================================
# Database
# ============================================
DATASOURCE_PORT=5432
DATASOURCE_USER=laravel_user
DATASOURCE_PASSWORD=your_secure_password_here
DATASOURCE_DB=laravel_production

# ============================================
# PostgreSQL Admin
# ============================================
ADMIN_USERNAME=postgres_admin
ADMIN_PASSWORD=your_admin_password_here
PGADMIN_DEFAULT_EMAIL=admin@jim.dev
PGADMIN_DEFAULT_PASSWORD=your_pgadmin_password_here

# ============================================
# MinIO (S3)
# ============================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minio_secure_password_here
AWS_BUCKET=publications-bucket

# ============================================
# Laravel Application
# ============================================
APP_NAME="Johnny Application"
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:your_generated_app_key_here
APP_TIMEZONE=Asia/Yekaterinburg

# ============================================
# Security
# ============================================
SESSION_SECURE_COOKIE=true

# ============================================
# SSL Configuration
# ============================================
SSL_EMAIL=admin@example.com
SSL_RSA_KEY_SIZE=4096